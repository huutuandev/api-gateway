# Copy this file to .env and fill in real values
# Never commit .env with real secrets to Git

JWT_SECRET=change-this-to-a-long-rando

# Groq API key — required for /api/v1/ai/chat endpoint
# Uses Groq's OpenAI-compatible completions API
GROQ_API_KEY=gsk_...your-key-here...

DB_USERNAME=example
DB_PASSWORD=example
DB_URL=jdbc:postgresql://example

REDIS_HOST=example
REDIS_PORT=1234
